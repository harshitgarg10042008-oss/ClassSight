# Database Configuration
POSTGRES_DB=classsight
POSTGRES_USER=classsight
POSTGRES_PASSWORD=classsight_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT Secret
JWT_SECRET=your_jwt_secret_here_change_in_production

# Service Ports
BACKEND_PORT=8080
FACE_SERVICE_PORT=8000
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Attendance and capture storage
ATTENDANCE_CAPTURE_STORAGE_BACKEND=minio
ATTENDANCE_CAPTURE_STORAGE_PATH=/app/data/captures
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=classsight-captures
MINIO_REGION=us-east-1
ATTENDANCE_RECOGNITION_THRESHOLD=0.6
RECOGNITION_MODE=sync
RABBITMQ_USER=classsight
RABBITMQ_PASSWORD=classsight_rabbit_password
ATTENDANCE_DEFAULTER_THRESHOLD=75
CLASSSIGHT_ERP_EXPORT_DIR=/app/exports
CLASSSIGHT_CAMERA_HEALTH_INTERVAL_MS=5000
CLASSSIGHT_CAMERA_HEALTH_INITIAL_DELAY_MS=5000

# Image quality/liveness thresholds
QUALITY_BLUR_THRESHOLD=30.0
QUALITY_MIN_BRIGHTNESS=35.0
QUALITY_MAX_BRIGHTNESS=220.0
QUALITY_MIN_LIVENESS_TEXTURE=2.5
QUALITY_MIN_FACE_SIZE_RATIO=0.0005
