# Database Configuration
POSTGRES_DB=classsight
POSTGRES_USER=classsight
POSTGRES_PASSWORD=classsight_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT Secret
JWT_SECRET=your_jwt_secret_here_change_in_production

# Service Ports
BACKEND_PORT=8080
FACE_SERVICE_PORT=8000

# Attendance and capture storage
ATTENDANCE_CAPTURE_STORAGE_PATH=/app/data/captures
ATTENDANCE_RECOGNITION_THRESHOLD=0.6
ATTENDANCE_DEFAULTER_THRESHOLD=75

# Image quality/liveness thresholds
QUALITY_BLUR_THRESHOLD=30.0
QUALITY_MIN_BRIGHTNESS=35.0
QUALITY_MAX_BRIGHTNESS=220.0
QUALITY_MIN_LIVENESS_TEXTURE=2.5
QUALITY_MIN_FACE_SIZE_RATIO=0.0005
